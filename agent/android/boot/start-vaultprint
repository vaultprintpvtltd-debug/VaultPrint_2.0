#!/data/data/com.termux/files/usr/bin/sh
# ---------------------------------------------------------------------------
# Termux:Boot entry point — starts the VaultPrint print agent at every boot.
# Install: copy to ~/.termux/boot/start-vaultprint (chmod 700) and open the
# Termux:Boot app once. The agent's watchdog then locks the kiosk screen.
#
# Hands off to android/supervise.sh as root, at once: Android may kill the
# Termux app as an idle process a minute after boot, taking every process it
# started with it. The root supervisor lives outside the app and survives.
# ---------------------------------------------------------------------------

AGENT="$HOME/vaultprint/agent"
/system/bin/su -c "nohup /system/bin/sh $AGENT/android/supervise.sh </dev/null >/dev/null 2>&1 &"
